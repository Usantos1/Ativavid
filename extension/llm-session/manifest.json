{
  "manifest_version": 3,
  "name": "ATIVAVID Session",
  "version": "0.1.3",
  "description": "Mantém a sessão web (cookies) dos LLMs sincronizada com o ATIVAVID local — em segundo plano.",
  "permissions": ["cookies", "storage", "alarms", "tabs"],
  "host_permissions": [
    "http://127.0.0.1:4850/*",
    "http://localhost:4850/*",
    "https://gemini.google.com/*",
    "https://*.google.com/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://chat.deepseek.com/*",
    "https://*.deepseek.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "ATIVAVID Session",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
