# Secrets
.env
.env.local
*.pem
*.key

# Config de licença da build de venda (fica só na máquina que compila o
# instalador). O modelo versionado é license_config.example.json.
license_config.json

# Cache da CLI do Supabase
supabase/.temp/

# Preferências desta máquina (o app grava supabaseUrl/anon aqui no caminho
# legado). É estado local, e commitar acabaria vazando chave um dia.
.ativavid-settings.json

# Vídeos de trabalho do benchmark de render: masters sem perda e variantes
# passam de 500 MB. O que sustenta a conclusão — os .json e os mosaicos PNG —
# fica versionado; os intermediários, não.
tools/render_benchmark/results/_camada1/
tools/render_benchmark/results/_ig_tmp/
tools/render_benchmark/results/_npl_multi/
tools/render_benchmark/results/_prep_npl/

# Runtime state, not source: the preview server rewrites this on every
# "Salvar como padrão" click in the Estilo tab, so tracking it would turn one
# machine's house style into a diff on every other machine.
assets/preview/default-style.json

# Per-project launcher, hardcoded to one editing folder
preview-larissa.cmd

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/
ENV/

# Editors / IDEs
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Node / Remotion (installed on demand, not vendored)
node_modules/
package-lock.json
yarn.lock
.npm/

# Manim render artifacts (when running skills/manim-video scripts locally)
media/
*.log

# Session artifacts if someone invokes the skill inside the project dir
# (normally outputs go to <videos_dir>/edit/ — keep these as a safety net)
edit/
transcripts/
animations/
clips_graded/
clips_preview/
downloads/
verify/
preview.mp4
final.mp4
base.mp4
base_preview.mp4
master.srt
takes_packed.md
edl.json
project.md

# Personal, per-creator templates (never committed — each user builds their own)
templates/

.ativavid-sessions.json
.ativavid-sessions.tmp

# FFmpeg embutido pelo setup.ps1 (binários grandes)
vendor/ffmpeg/*.exe
vendor/ffmpeg/*.dll
!vendor/ffmpeg/.gitkeep
