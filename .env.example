GROQ_API_KEY=
# PHASE 1 transcription of LONG sources (>5 min, e.g. YouTube videos / course lessons).
# Optional — with backend=auto, sources longer than 5 min use ElevenLabs Scribe when this
# key is set (Groq's free tier struggles with long uploads); short clips stay on Groq.
# Falls back to Groq if empty. https://elevenlabs.io/app/settings/api-keys
# Also powers PHASE 3 AI soundtrack (elevenlabs_music.py, Music v2) — same key, but
# that endpoint needs a PAID ElevenLabs plan; a local music file needs no key at all.
ELEVENLABS_API_KEY=
# PHASE 2 illustrative images (Pexels) — https://www.pexels.com/api/
PEXELS_API_KEY=
# PHASE 2 brand/person images (Google Custom Search) — see skill for how to get these
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
